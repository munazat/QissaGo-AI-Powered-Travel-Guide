# Copy this file to ".env" (same folder) and change values if needed. Never commit .env.
DATABASE_URL=postgresql+psycopg://qissago:qissago@localhost:5432/qissago

# Any long random text. Used to sign login tokens.
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# Chatbot language model: "ollama" (free, local) or "none" (rules only, no download needed)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Live weather from Open-Meteo (free). false = always use typical seasonal weather.
LIVE_WEATHER=true

# Websites allowed to call the API. "*" is fine for development.
CORS_ORIGINS=*
